<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/screen_pad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/gap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spectrum ��"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:id="@+id/greeting"
                    android:paddingTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oi. Um toque já é cuidado."/>
            </LinearLayout>
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/sprig"
                android:contentDescription="@null"/>
        </LinearLayout>
        <Button
            android:id="@+id/sosButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="Preciso de ajuda agora"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_help"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
        <TextView
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agora, 1 toque"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Não precisa abrir a roda. Só diz como o sistema está."/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/quickPause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="Pausar"
                android:drawableTop="@drawable/ic_pause"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
            <Button
                android:id="@+id/quickQuiet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="Silêncio"
                android:drawableTop="@drawable/ic_quiet"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <Button
                android:id="@+id/quickBattery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="Bateria baixa"
                android:drawableTop="@drawable/ic_battery"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
            <Button
                android:id="@+id/quickOkay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="Ok o suficiente"
                android:drawableTop="@drawable/ic_ok"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
        </LinearLayout>
        <TextView
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:id="@+id/kidFeelTitle"
            android:paddingTop="14dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Como está agora?"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/kidFeelings"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/boardLangRow"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/langPt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="PT"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
            <Button
                android:id="@+id/langEn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="EN"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
            <Button
                android:id="@+id/langEs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="ES"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/aacBoard"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/calmSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tela mais calma"/>
        <TextView
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:id="@+id/weekTitle"
            android:paddingTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Esta semana"/>
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bolinha cheia = teve registro. Vazio não é falha."/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/weekStrip"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/wheelCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/card_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.spectrum.app.ui.EmotionWheelView
                    android:id="@+id/wheel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:id="@+id/selectedSummary"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <Button
                    android:id="@+id/registrar"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Registrar"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Button
            android:id="@+id/toolsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="Cuidado e ferramentas"
            style="@style/Widget.Material3.Button.TonalButton"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/dockSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Atalho quieto na notificação"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fica o tempo todo, sem som. Não pergunta a cada hora. Igual / Pausar / Ok — a roda só se você quiser."/>
        <TextView
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seu histórico"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todos"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipFelizes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Felizes"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipTristes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tristes"
                style="@style/Widget.Material3.Chip.Filter"/>
        </com.google.android.material.chip.ChipGroup>
        <TextView
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:id="@+id/historyCount"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/limpar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Limpar histórico"
            style="@style/Widget.Material3.Button.TextButton"/>
    </LinearLayout>
</ScrollView>
