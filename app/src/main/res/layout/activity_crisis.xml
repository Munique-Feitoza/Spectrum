<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Você não está sozinha"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/sprig"
                android:contentDescription="@null"/>
        </LinearLayout>
        <TextView
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Se você está em perigo imediato, ligue 192. Para conversar agora — de graça, 24h e em sigilo — o CVV está aqui pra te ouvir."/>
        <Button
            android:id="@+id/btnCvv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ligar para o CVV — 188"/>
        <Button
            android:id="@+id/btnSamu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="Ligar para o SAMU — 192"
            style="@style/Widget.Material3.Button.TonalButton"/>
        <Button
            android:id="@+id/btnTrusted"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="52dp"
            android:text="Pessoa de confiança"
            style="@style/Widget.Material3.Button.TonalButton"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/card_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Respire comigo"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:paddingTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inspire pelo nariz contando até 4.\10Segure o ar contando até 4.\10Solte devagar pela boca contando até 6.\10Repita algumas vezes, sem pressa."
                    android:lineSpacingMultiplier="1.15"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/card_pad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seu plano de segurança"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:id="@+id/planoText"
                    android:paddingTop="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.12"/>
                <Button
                    android:id="@+id/btnPlano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Abrir / editar meu plano de segurança"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
